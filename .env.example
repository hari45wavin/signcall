# ---- LiveKit (https://cloud.livekit.io -> Settings -> Keys) ----
# Server-side only. Used by web/src/app/api/token/route.ts
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public: the browser connects here
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Inference ----
# WebSocket URL of the FastAPI server (wss:// in production)
NEXT_PUBLIC_INFERENCE_WS_URL=ws://localhost:8000/ws/predict

# ---- Inference server (inference/.env) ----
MODEL_PATH=models/static.onnx
ALLOWED_ORIGINS=http://localhost:3000
# Optional LLM sentence cleanup. Leave empty to disable.
CLEANUP_API_KEY=
CLEANUP_TIMEOUT_MS=800
